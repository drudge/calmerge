# FEEDS is a JSON array of calendars. Keep it on ONE line in a .env file.
#
# Per-feed fields:
#   name  (required) - label shown on the source pill
#   url   (required) - the ICS/iCal feed URL (treat it as a secret)
#   color (optional) - hex; feeds without one take a default palette in order
#   user/pass (optional) - HTTP basic auth, if your feed needs it

FEEDS=[{"name":"Work","url":"https://outlook.office365.com/owa/calendar/<id>@example.com/<key>/calendar.ics"},{"name":"Freelance","url":"https://example.com/calendar/<key>/Calendar.ics"},{"name":"Family","url":"https://p00-caldav.icloud.com/published/2/<key>"}]

# INCLUDE_ATTENDEES / INCLUDE_AGENDA toggle the per-event attendee list (with
# organizer) and the cleaned-up agenda text (DESCRIPTION with the Teams/Zoom/Meet
# join boilerplate stripped). Both default to true; set to false to trim the
# payload if you don't need them.
INCLUDE_ATTENDEES=true
INCLUDE_AGENDA=true

# Prefer the config file for everything except AUTH_TOKEN: see
# calmerge.example.toml, mounted at /config/calmerge.toml. It's hot-reloaded,
# and anything it leaves out falls back to these env vars. Entities (client
# tagging) are far easier to manage there than as one-line ENTITIES JSON.

# AUTH_TOKEN protects the externally-reachable path (Cloudflare tunnel). It is
# required only for requests that arrive through the tunnel (Cloudflare adds a
# Cf-Connecting-Ip header); internal Glance requests stay token-free. Leave it
# empty to keep the API internal-only — tunnel requests are then rejected with
# 401. Callers send the header:  Authorization: Bearer <token>
# Generate a strong one with:    openssl rand -hex 32
AUTH_TOKEN=

# REQUIRE_AUTH=true makes every /events and /mcp request need the token, not
# just tunnel traffic. Use it when anything besides a Cloudflare tunnel (another
# reverse proxy, a published port, a shared network) can reach calmerge.
REQUIRE_AUTH=false
